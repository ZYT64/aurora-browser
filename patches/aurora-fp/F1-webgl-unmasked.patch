From e036f77fe22d18ecdd19b08a10083f515bbbde51 Mon Sep 17 00:00:00 2026
From: kuroneko <leafpanda@agent.qq.com>
Date: Wed, 16 Nov 2026 15:55:00 +0800
Subject: [PATCH] AURORA-FP F1: WebGL UNMASKED_VENDOR/RENDERER engine override

ENGINE-LEVEL override for WEBGL_debug_renderer_info: getParameter
(UNMASKED_VENDOR / UNMASKED_RENDERER) reads static compile-time
persona constants instead of the live ANGLE context string.

Source paths (verified against Chromium main branch):
  third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
    L4358-4370: kUnmaskedRendererWebgl / kUnmaskedVendorWebgl cases
  third_party/blink/renderer/modules/webgl/aurora_persona.h
    (generated by scripts/gen_persona_header.py)

--- a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
@@ -4355,14 +4355,14 @@ WebGLAny WebGLRenderingContextBase::GetParameterImpl(
     case WebGLDebugRendererInfo::kUnmaskedRendererWebgl:
       if (ExtensionEnabled(kWebGLDebugRendererInfoName)) {
         return WebGLAny(script_state,
-                        String(ContextGL()->GetString(GL_RENDERER)));
+                        String(kAuroraGLRenderer));
       }
       SynthesizeGLError(
           GL_INVALID_ENUM, "getParameter",
           "invalid parameter name, WEBGL_debug_renderer_info not enabled");
       return ScriptValue::CreateNull(script_state->GetIsolate());
     case WebGLDebugRendererInfo::kUnmaskedVendorWebgl:
       if (ExtensionEnabled(kWebGLDebugRendererInfoName)) {
-        return WebGLAny(script_state,
-                        String(ContextGL()->GetString(GL_VENDOR)));
+        return WebGLAny(script_state, String(kAuroraGLVendor));
       }
       SynthesizeGLError(
           GL_INVALID_ENUM, "getParameter",
           "invalid parameter name, WEBGL_debug_renderer_info not enabled");
       return ScriptValue::CreateNull(script_state->GetIsolate());
--- a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
@@ -126,6 +126,8 @@
 #include "third_party/blink/renderer/modules/webgl/webgl_debug_renderer_info.h"
+#include "third_party/blink/renderer/modules/webgl/aurora_persona.h"
+
 namespace blink {
